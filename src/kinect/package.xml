<?xml version="1.0"?>
<package format="3">
  <name>kinect</name>
  <version>0.0.1</version>
  <description>Kinect v2 ROS 2 driver using libfreenect2 to publish RGB, depth, and audio.</description>

  <maintainer email="you@example.com">Sriharsha</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>opencv</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
